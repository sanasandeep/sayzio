{
  "expo": {
    "name": "1INME",
    "slug": "1inme-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "1inme",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.oneinme.app",
      "associatedDomains": [
        "applinks:1inme.com",
        "applinks:www.1inme.com"
      ],
      "infoPlist": {
        "NSContactsUsageDescription": "1INME can read your contacts so you can save someone you just met as a contact card from their 1INME profile.",
        "NSLocationWhenInUseUsageDescription": "1INME records the approximate location of NFC tag writes so you can see where each tag was provisioned. This is optional and only used while the app is open.",
        "NFCReaderUsageDescription": "1INME writes your short link to NFC tags so a tap opens your profile."
      }
    },
    "android": {
      "package": "com.oneinme.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0a0f"
      },
      "permissions": [
        "android.permission.NFC",
        "android.permission.READ_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "1inme.com" },
            { "scheme": "https", "host": "www.1inme.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        { "origin": "https://1inme.com/" }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#7c3aed",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#7c3aed"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "react-native-nfc-manager",
      [
        "expo-contacts",
        { "contactsPermission": "1INME can read your contacts so you can save someone you just met as a contact card." }
      ],
      [
        "expo-location",
        { "locationWhenInUsePermission": "1INME records the approximate location of NFC tag writes so you can see where each tag was provisioned." }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
