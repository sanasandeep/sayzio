<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            CLI memory ceiling for the suite. PHPUnit runs every test in a
            single long-lived PHP process, so each test's fresh Laravel app
            boot (route registration of the ~1.4k-line routes/modules/user.php,
            container, config) plus the cyclic object graphs a test creates
            (request/response, Eloquent models) add to the resident footprint.
            Under the stock 128M limit the process exhausts memory partway
            through route registration, aborting mid-file: earlier GET routes
            register but later POST routes for the same URI do not, so requests
            like POST /user/links/{id}/slides surface a spurious 405 Method Not
            Allowed (or the run dies before later tests, e.g.
            SlidesModeEndToEndTest, even execute).

            The durable mitigation lives in tests/TestCase::tearDown(), which
            forces gc_collect_cycles() after each test. That reclaims the cyclic
            garbage immediately instead of waiting for PHP's automatic collector
            to fill its root buffer, lowering both the resident baseline and the
            per-test growth slope (~50% reduction in peak growth on the
            boot+request lifecycle). With that in place the full Feature suite
            peaks well under this ceiling, so it was lowered from the temporary
            1024M workaround to 512M (still ~2x headroom). If this is ever hit
            again as the app grows, prefer process isolation (sharding the run
            into multiple sequential phpunit processes) over raising it further.

            Process isolation IS now available: `composer test:sharded` (see
            scripts/run-sharded-tests.php) splits the suite across several
            short-lived phpunit processes so peak memory is bounded by the
            largest shard, not the whole suite, regardless of how many tests
            are added. A single `migrate:fresh` is shared across all shards via
            tests/bootstrap.php, so the slow migration is paid only once. Use
            the sharded runner whenever the single-process run gets close to
            this ceiling again.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Default the suite to PostgreSQL so local runs exercise the same
            engine production uses. Without this, sqlite's in-memory driver
            silently masks Postgres-only bugs (e.g. jsonb `?` operator
            collisions, Postgres-specific DDL) that the CI workflow at
            .github/workflows/laravel-tests.yml is meant to catch.

            DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD are intentionally
            not pinned here — they fall through to whatever the developer's
            .env (or CI process env) provides. Only DB_CONNECTION and
            DB_DATABASE are forced, so the test suite always targets a
            dedicated `1inme_testing` database and never trample the
            developer's dev DB when RefreshDatabase wipes the schema.

            See artifacts/1inme/CONTRIBUTING.md for setup instructions.

            Note: PHPUnit `<env>` does not override values already present in
            the process environment unless force="true". CI sets DB_DATABASE
            etc. as real env vars, so those still win in CI as before.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="1inme_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
