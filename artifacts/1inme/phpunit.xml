<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            Raise the CLI memory ceiling for the suite. PHPUnit runs every
            test in a single long-lived PHP process, so each test's fresh
            Laravel app boot (route registration, container, config) adds to
            the resident footprint. Under the stock 128M limit the process
            exhausts memory partway through route registration (routes/
            modules/user.php is ~1.4k lines), which aborts mid-file: earlier
            GET routes register but later POST routes for the same URI do
            not, so requests like POST /user/links/{id}/slides surface a
            spurious 405 Method Not Allowed (or the whole run dies before
            later tests, e.g. SlidesModeEndToEndTest, even execute). A higher
            ceiling lets the full Feature suite register all routes and run
            to completion deterministically.
        -->
        <ini name="memory_limit" value="1024M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!--
            Default the suite to PostgreSQL so local runs exercise the same
            engine production uses. Without this, sqlite's in-memory driver
            silently masks Postgres-only bugs (e.g. jsonb `?` operator
            collisions, Postgres-specific DDL) that the CI workflow at
            .github/workflows/laravel-tests.yml is meant to catch.

            DB_HOST / DB_PORT / DB_USERNAME / DB_PASSWORD are intentionally
            not pinned here — they fall through to whatever the developer's
            .env (or CI process env) provides. Only DB_CONNECTION and
            DB_DATABASE are forced, so the test suite always targets a
            dedicated `1inme_testing` database and never trample the
            developer's dev DB when RefreshDatabase wipes the schema.

            See artifacts/1inme/CONTRIBUTING.md for setup instructions.

            Note: PHPUnit `<env>` does not override values already present in
            the process environment unless force="true". CI sets DB_DATABASE
            etc. as real env vars, so those still win in CI as before.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="1inme_testing"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
