APP_NAME=1INME
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=1inme
DB_USERNAME=
DB_PASSWORD=
# Set to "require" when connecting to an external Postgres (e.g. AWS RDS) that
# enforces SSL. Defaults to "prefer" for local development.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@1inme.com"
MAIL_FROM_NAME="${APP_NAME}"

# User-content storage. Set USER_CONTENT_DISK=s3 to back the `public`,
# `user_files`, and `admin_assets` disks with S3 (durable + CloudFront);
# leave as `local` for on-disk storage. The AWS_* values configure the
# bucket; AWS_URL is the CloudFront domain used to build public URLs.
# AWS_USE_PATH_STYLE_ENDPOINT must be true for dotted bucket names (e.g.
# 1in.me) because virtual-hosted-style HTTPS breaks on dots.
USER_CONTENT_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=
MSG91_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# The variables below default sensibly or are optional. See
# deploy/ec2/env-checklist.md for the complete audit (secrets, admin-DB-backed
# fallbacks, and Replit-only variables).
# ---------------------------------------------------------------------------

# Platform defaults
PLATFORM_DEFAULT_TIMEZONE=Asia/Kolkata
# Comma-separated previous APP_KEYs, only needed after a key rotation.
APP_PREVIOUS_KEYS=
# Keep the persistent PDO connection warm per worker (big win when RDS is in
# a distant region; either value is fine when the DB is in the same VPC).
DB_PERSISTENT=true

# SMS OTP (MSG91) — see above MSG91_* block.

# WhatsApp Business API (OTP delivery + WhatsApp agent)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=otp_code
WHATSAPP_TEMPLATE_LANG=en_US
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_AGENT_ENABLED=false

# Reviews import (admin-DB-backed: Admin -> Integrations overrides these;
# absent keys = transparent preview mode)
GOOGLE_PLACES_API_KEY=
TRUSTPILOT_API_KEY=

# OAuth clients (Google Contacts is admin-DB-backed too)
GOOGLE_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_TENANT=common
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_API_KEY=
CONNECTED_APPS_GA_ENABLED=false

# AI Artistic QR (Replicate; admin AiEngineSettings overrides; absent = preview)
REPLICATE_API_TOKEN=
#REPLICATE_QR_MODEL=zylim0702/qr_code_controlnet

# Billing / invoicing identity (invoice letterhead + webhook signing)
MERCHANT_LEGAL_NAME=
MERCHANT_ADDRESS=
MERCHANT_COUNTRY=IN
MERCHANT_GST_STATE=MH
MERCHANT_GSTIN=
MERCHANT_VATIN=
MERCHANT_SUPPORT_EMAIL=
#FY_START_MONTH=4
#INVOICE_PREFIX=INV
BILLING_ACTIVATION_SECRET=

# Super-admin master override password (bcrypt hash). Leave empty to disable.
MASTER_OVERRIDE_PASSWORD_HASH=

# Mobile deep-link association files (assetlinks.json / apple-app-site-association)
ANDROID_PACKAGE_NAME=
ANDROID_SHA256_FINGERPRINTS=
APPLE_BUNDLE_ID=
APPLE_TEAM_ID=

# Platform role-grant alerting
#PLATFORM_ROLE_ALERT_ROLES=user-admin
#PLATFORM_ROLE_ALERT_RECIPIENTS=

# Custom-domain DNS drift grace window (hours)
#DOMAIN_DRIFT_GRACE_HOURS=168

# Sanctum API tokens
#SANCTUM_STATEFUL_DOMAINS=
#SANCTUM_EXPIRATION_MINUTES=86400

# Dev-only toggles — NEVER set these in production:
#   ALLOW_DESTRUCTIVE_DB_COMMANDS, MONETIZATION_FORCE_PREVIEW, UPLOAD_SCANNER_DISABLED
