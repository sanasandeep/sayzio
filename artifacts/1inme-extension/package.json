{
  "name": "@workspace/1inme-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "1INME browser extension (Chrome, Firefox, Edge): one-click shorten + page-to-biolink",
  "scripts": {
    "build": "node scripts/build.mjs chrome",
    "build:chrome": "node scripts/build.mjs chrome",
    "build:firefox": "node scripts/build.mjs firefox",
    "build:edge": "node scripts/build.mjs edge",
    "build:all": "node scripts/build.mjs all",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --import ./src/lib/test-setup.ts --test src/lib/*.test.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webextension-polyfill": "^0.12.1",
    "@vitejs/plugin-react": "catalog:",
    "archiver": "^7.0.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.6.0",
    "vite": "catalog:",
    "webextension-polyfill": "^0.12.0"
  }
}
