const SOCIAL_HOSTS: Record<string, string> = {
  "instagram.com": "instagram",
  "twitter.com": "twitter",
  "x.com": "twitter",
  "tiktok.com": "tiktok",
  "youtube.com": "youtube",
  "youtu.be": "youtube",
