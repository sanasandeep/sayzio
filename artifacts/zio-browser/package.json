{
  "name": "@workspace/zio-browser",
  "version": "0.1.8",
  "private": true,
  "description": "Zio Browser — AI-powered companion browser for Mac and Windows",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:renderer\" \"pnpm run dev:main\"",
    "dev:renderer": "vite",
    "dev:main": "tsc -p tsconfig.main.json --watch",
    "build": "pnpm run build:renderer && pnpm run build:main",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "package": "pnpm run build && pnpm run build:preload && electron-builder --config electron-builder.config.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.preload.json --noEmit",
    "pretest": "node scripts/ensure-better-sqlite3.cjs",
    "test": "vitest run",
    "pretest:watch": "node scripts/ensure-better-sqlite3.cjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.1.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.14.0",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "concurrently": "^8.2.2",
    "electron": "^31.0.0",
    "electron-builder": "^24.9.4",
    "prebuild-install": "^7.1.3",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "^5.5.0",
    "vite": "catalog:",
    "vitest": "^4.1.9"
  }
}
