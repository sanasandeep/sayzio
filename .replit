modules = ["nodejs-24", "php-8.4", "python-3.11", "system", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-contact-jump-to-record"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "eas-apk-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-event-features"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-home-fast-lean"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-auth-modal-error-tab-restore"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-payouts-nav-placement"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-zio-sync-plan-gate"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-assistant-page-snapshot"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-topbar-autohide"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-connect-qr-prompt"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-connect-qr"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "expo-project-link-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "eas-lockfile-registry-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-embed-panel-text-card"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-embed-card-state-heights"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-event-location-map-paste"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-marketing-plan-calculator"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-marketing-plan-export"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mpc-dirty-guard"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-admin-minimized-sidebar"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mpc-presets"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mpc-finance-metrics"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-settings-tabs-scroll"
    
[[workflows.workflow]]
name = "e2e-contact-jump-to-record"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/1inme-mobile run test:contact-jump-to-record-real-api-e2e"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "eas-apk-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd /home/runner/workspace/artifacts/1inme-mobile && EAS_NO_VCS=1 npx -y eas-cli build --platform android --profile preview --non-interactive --no-wait 2>&1"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-event-features"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5055 bash tests/Browser/run-validation.sh event-guest-broadcast.spec.ts event-waitlist-promotion.spec.ts event-public-page-calendar.spec.ts calendar-settings-apple-microsoft.spec.ts"

[[workflows.workflow]]
name = "e2e-home-fast-lean"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5062 bash tests/Browser/run-validation.sh home-hero-claim-handle.spec.ts"

[[workflows.workflow]]
name = "e2e-auth-modal-error-tab-restore"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5063 bash tests/Browser/run-validation.sh auth-modal-error-tab-restore.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-payouts-nav-placement"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5071 bash tests/Browser/run-validation.sh payouts-nav-placement.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-zio-sync-plan-gate"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/zio-browser/tests/e2e-sync-plan-gate/run.sh"

[workflows.workflow.metadata]
isValidation = true


  [agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AWS_BUCKET = "1in.me"
AWS_DEFAULT_REGION = "ap-south-2"
AWS_URL = "https://d3l7wvr1shk1cg.cloudfront.net"
AWS_USE_PATH_STYLE_ENDPOINT = "true"
USER_CONTENT_DISK = "s3"
CONTACT_ADMIN_TOKEN = ""
APP_NAME = "Sayzio"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 23680
externalPort = 3003

[[ports]]
localPort = 23681
externalPort = 80

