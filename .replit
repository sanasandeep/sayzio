modules = ["nodejs-24", "php-8.4", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "template-designs"

[[workflows.workflow]]
name = "template-designs"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && php artisan templates:check-designs"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3002

[[ports]]
localPort = 8083
externalPort = 3003

[[ports]]
localPort = 20346
externalPort = 5000

[[ports]]
localPort = 22245
externalPort = 3000

[[ports]]
localPort = 23680
externalPort = 3001

[[ports]]
localPort = 23681
externalPort = 6000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AWS_BUCKET = "1in.me"
AWS_DEFAULT_REGION = "ap-south-2"
AWS_URL = "https://d3l7wvr1shk1cg.cloudfront.net"
AWS_USE_PATH_STYLE_ENDPOINT = "true"
USER_CONTENT_DISK = "s3"
CONTACT_ADMIN_TOKEN = "RP8TvxVjeyRZabgOUgSjT-fBNw-IaNBA"
