modules = ["nodejs-24", "php-8.4", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mobile-main"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mobile-google"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "php-deprecations"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "brand-color"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test:1inme-com"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-voice-panel"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migration-ordering"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-strategy"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-unit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mobile-icons"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mobile-icons-native"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ai-tool-names"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "scripts-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "favicon-sync"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "home-preview-blocks"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "demo-allowlist"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "ci-passthrough-names"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "brand-color-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "mobile-docs-parity"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "check-plan-feature-coverage"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "light-mode-pairing"

[[workflows.workflow]]
name = "e2e"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/1inme/tests/Browser/run-validation.sh home-auth-modal-mobile.spec.ts biolink-editor-card-gallery-preview.spec.ts biolink-editor-palette-dnd.spec.ts cookie-consent-footer-gap.spec.ts cookie-consent-layout-styles.spec.ts cookie-consent-theme-match.spec.ts voice-assistant-bridge.spec.ts voice-assistant-panel.spec.ts slides-mode.spec.ts cookie-consent-footer-reserve.spec.ts home-hero-orbit-popover.spec.ts home-hero-claim-handle.spec.ts brand-consistency-apply-fix.spec.ts create-link-picker.spec.ts marketing-background-seam.spec.ts home-section-structure.spec.ts home-ai-zone.spec.ts onboarding-flow.spec.ts dashboard-layout.spec.ts header-account-menu.spec.ts header-mobile-account-menu.spec.ts header-mobile-logged-out-cta.spec.ts dashboard-mobile-account.spec.ts header-desktop-logged-out-cta.spec.ts dialer-live-sync.spec.ts store-coming-soon-modal.spec.ts ai-dashboard-demo-perf.spec.ts event-rsvp-light-readability.spec.ts"

[[workflows.workflow]]
name = "e2e-mobile-main"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/1inme-mobile run test:auth-flow-e2e:core"

[[workflows.workflow]]
name = "e2e-mobile-google"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/1inme-mobile run test:auth-flow-e2e:google"

[[workflows.workflow]]
name = "php-deprecations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && composer lint:deprecations"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "brand-color"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run check:brand-color"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test:1inme-com"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/1inme-com run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-voice-panel"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/1inme/tests/Browser/run-validation.sh voice-assistant-panel.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "migration-ordering"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && composer check:migration-ordering"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-strategy"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/1inme-mobile run test:strategy-stream && pnpm --filter @workspace/1inme-mobile run test:strategy-screens"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "mobile-unit"
author = "agent"

[[workflows.workflow.tasks]]
