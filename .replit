args = "pnpm --filter @workspace/scripts run check:home-preview-blocks"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "demo-allowlist"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && composer check:demo-allowlist"

