[[workflows.workflow]]
name = "heading-accents-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && TEST_LOCAL_MODE=artisan bash scripts/test-local.sh --filter=HeadingAccentDecorationsTest"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-image-sticker-drag-place"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "VALIDATION_PORT=5051 bash artifacts/1inme/tests/Browser/run-validation.sh image-sticker-drag-place.spec.ts"

[[workflows.workflow]]
