modules = ["nodejs-24", "php-8.4", "python-3.11", "system", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-mobile-main"

[[workflows.workflow.tasks]]
