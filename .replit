modules = ["nodejs-24", "php-8.4", "python-3.11", "system", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-block-defaults"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-social-proof-editor"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "blade-inline-js"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-biolink-editor-inline-edit"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-bg-effect-types"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-bg-preset-live-single"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "e2e-biolink-editor-preview-focus"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "eas-apk-build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "zio-browser-test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "eas-dialer-build-kick"

[[workflows.workflow]]
name = "e2e-block-defaults"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/1inme/tests/Browser/run-validation.sh biolink-block-bg-preset-e2e.spec.ts biolink-block-bg-preset-opacity-live.spec.ts biolink-block-bg-preset-swatch-live.spec.ts biolink-bg-preset-public-render.spec.ts biolink-bg-preset-live-preview.spec.ts"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "e2e-social-proof-editor"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5163 bash tests/Browser/run-validation.sh social-proof-editor.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "blade-inline-js"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && node scripts/check-blade-inline-scripts.mjs"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-biolink-editor-inline-edit"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/1inme/tests/Browser/run-validation.sh biolink-editor-inline-edit.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-bg-effect-types"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash artifacts/1inme/tests/Browser/run-validation.sh biolink-bg-effect-types.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-bg-preset-live-single"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme && VALIDATION_PORT=5171 bash tests/Browser/run-validation.sh biolink-bg-preset-live-preview.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "e2e-biolink-editor-preview-focus"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "VALIDATION_PORT=5065 bash artifacts/1inme/tests/Browser/run-validation.sh biolink-editor-preview-focus.spec.ts"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "eas-apk-build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd artifacts/1inme-mobile && EAS_NO_VCS=1 npx -y eas-cli build --platform android --profile preview --non-interactive --no-wait 2>&1 | tee /tmp/eas-build-kick.log"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "zio-browser-test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/zio-browser run test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "eas-dialer-build-kick"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd sayzio-dialer-standalone && EAS_NO_VCS=1 npx -y eas-cli build --platform android --profile preview --non-interactive --no-wait 2>&1 | tee /tmp/eas-dialer-kick.log"

[workflows.workflow.metadata]
isValidation = true


  [agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AWS_BUCKET = "1in.me"
AWS_DEFAULT_REGION = "ap-south-2"
AWS_URL = "https://d3l7wvr1shk1cg.cloudfront.net"
AWS_USE_PATH_STYLE_ENDPOINT = "true"
USER_CONTENT_DISK = "s3"

APP_NAME = "Sayzio"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 5050
externalPort = 3000

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 8082
externalPort = 3001

[[ports]]
localPort = 23680
externalPort = 3003

[[ports]]
localPort = 23681
externalPort = 80
