[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 600000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
AWS_BUCKET = "1in.me"
AWS_DEFAULT_REGION = "ap-south-2"
AWS_URL = "https://d3l7wvr1shk1cg.cloudfront.net"
AWS_USE_PATH_STYLE_ENDPOINT = "true"
USER_CONTENT_DISK = "s3"
CONTACT_ADMIN_TOKEN = "RP8TvxVjeyRZabgOUgSjT-fBNw-IaNBA"
APP_NAME = "Sayzio"

[[ports]]
