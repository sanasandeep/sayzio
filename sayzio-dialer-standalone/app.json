{
  "expo": {
    "name": "Zio Dialer",
    "slug": "sayzio-dialer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sayzio",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#3d6bff"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.sayzio.dialer",
      "infoPlist": {
        "NSContactsUsageDescription": "Zio Dialer reads your contacts so you can call, message and manage them, and match incoming numbers to saved people.",
        "NSLocationWhenInUseUsageDescription": "Zio Dialer can show and pick a contact's location on a map. This is optional and only used while the app is open.",
        "NSFaceIDUsageDescription": "Zio Dialer uses Face ID so you can unlock the app without re-entering your code."
      }
    },
    "android": {
      "package": "com.sayzio.dialer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon-foreground.png",
        "backgroundColor": "#00000a"
      },
      "permissions": [
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.VIBRATE",
        "android.permission.CALL_PHONE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALL_LOG",
        "android.permission.READ_PHONE_STATE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "./plugins/withAndroidQueries.js",
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#3d6bff",
          "imageWidth": 220,
          "dark": {
            "image": "./assets/images/icon.png",
            "backgroundColor": "#3d6bff"
          }
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Zio Dialer uses Face ID so you can unlock the app without re-entering your code."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Zio Dialer can read your contacts so you can call, message and manage them."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Zio Dialer can show and pick a contact's location on a map."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9270d95-5c9e-4f42-bf84-37f0de65d0b4"
      }
    },
    "owner": "official1inmes-team"
  }
}
