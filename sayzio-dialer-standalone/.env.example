# ── Sayzio backend the dialer talks to ────────────────────────────────
# Point this at your Sayzio Laravel API. The app calls `${BASE}/api/v1/...`.
# Use EITHER a full base URL OR a bare domain (https:// is added for you).
#
# Full URL (recommended for local/staging backends):
EXPO_PUBLIC_API_BASE_URL=https://sayzio.app
#
# ...or a bare domain instead of the line above:
# EXPO_PUBLIC_DOMAIN=sayzio.app

# ── Google sign-in (optional) ─────────────────────────────────────────
# Leave unset to hide the "Continue with Google" button. Set the client id(s)
# that match the platform(s) you build for. These are the SAME Google OAuth
# clients used by your existing Sayzio app.
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
